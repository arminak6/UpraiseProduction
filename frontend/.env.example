# Optional API Testbench, separate from the final product.
# For a host-run Streamlit session; export/set this variable first.
# This file is not loaded automatically. Docker Compose supplies its own
# default, http://backend:8000, from the root .env or shell.
BACKEND_BASE_URL=http://localhost:8000
# Optional notice for a host-run UI when its backend is also explicitly in local mode:
UPRAISE_LOCAL_TEST_MODE=false
# Production A1/A2/A4: select your HTTPS gateway in the UI and supply
# OAuth token/client certificate there. Credentials are not stored in .env.
