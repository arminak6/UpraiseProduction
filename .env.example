# Optional Compose overrides. Never commit .env or credentials.
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_BASE_URL=http://backend:8000
UVICORN_LOG_LEVEL=info

# Existing PostgreSQL bootstrap account; use deployment credentials in production.
POSTGRES_DB=upraise_audit
POSTGRES_USER=upraise_dev
POSTGRES_PASSWORD=upraise_dev_password
JOBS_PASSWORD=upraise_jobs_password
AUDIT_PASSWORD=upraise_audit_password
# For special-character passwords, also set URI-encoded runtime connection strings.
# UPRAISE_JOBS_DSN=postgresql://upraise_jobs:ENCODED_PASSWORD@postgres:5432/upraise_jobs
# UPRAISE_AUDIT_DSN=postgresql://upraise_audit_app:ENCODED_PASSWORD@postgres:5432/upraise_audit

UPRAISE_AWS_REGION=eu-central-1
# Separate source-comparison pass; AUTO_CHECKED is not human verification.
UPRAISE_FIDELITY_VISION_MODEL_ID=eu.amazon.nova-pro-v1:0

# Production is the default. Local Streamlit testing requires BOTH explicit values:
# UPRAISE_ENVIRONMENT=development and UPRAISE_LOCAL_TEST_MODE=true.
UPRAISE_ENVIRONMENT=production
UPRAISE_LOCAL_TEST_MODE=false

# Ingestion is denied until all OAuth/mTLS settings below are supplied.
UPRAISE_OAUTH_ISSUER=
UPRAISE_OAUTH_AUDIENCE=
UPRAISE_OAUTH_JWKS_URL=
UPRAISE_OAUTH_CLIENTS=[]
UPRAISE_TRUSTED_PROXY_CIDRS=[]
UPRAISE_MTLS_ALLOWED_FINGERPRINTS=[]
# List values use JSON, e.g. ["middleware-client"] and ["10.0.0.2/32"].
# TLS gateway must overwrite X-SSL-Client-Verify and X-SSL-Client-Fingerprint.
# Access tokens require documents:write, documents:read, jobs:read and upraise_courses.

# HTTPS download mode: no redirects. Private Moodle addresses need explicit CIDRs.
UPRAISE_MOODLE_ALLOWED_CIDRS=[]

# Zero retains the old pipeline's artifacts until retention is agreed.
UPRAISE_ARTIFACT_RETENTION_DAYS=0

# Worker attempt wall-clock limit and workload-based phase budgets, in seconds.
# Defaults are starting values; tune with representative PDFs and prewarm models.
# Progress updates do not restart deadlines. Timeout retries use the attempt limit.
UPRAISE_JOB_TIMEOUT_SECONDS=43200
UPRAISE_PARSE_TIMEOUT_BASE_SECONDS=180
UPRAISE_PARSE_TIMEOUT_PER_PAGE_SECONDS=10
UPRAISE_PARSE_TIMEOUT_PER_OCR_PAGE_SECONDS=30
UPRAISE_ENRICH_TIMEOUT_BASE_SECONDS=180
UPRAISE_ENRICH_TIMEOUT_PER_REGION_SECONDS=180
UPRAISE_EMBED_TIMEOUT_BASE_SECONDS=120
UPRAISE_EMBED_TIMEOUT_PER_CHUNK_SECONDS=90
# Supervisor limits and cancellation polling; status reads never block the watchdog.
UPRAISE_WORKER_STARTUP_TIMEOUT_SECONDS=300
UPRAISE_WORKER_PHASE_TIMEOUT_SECONDS=300
UPRAISE_WORKER_SUPERVISOR_POLL_SECONDS=1
# PostgreSQL statement timeout, not a guaranteed socket-operation deadline.
UPRAISE_WORKER_STATUS_TIMEOUT_SECONDS=2
UPRAISE_WORKER_TERMINATE_GRACE_SECONDS=5
