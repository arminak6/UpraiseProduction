# Optional Compose overrides. Never commit .env or credentials.
BACKEND_PORT=8000
FRONTEND_PORT=8501
BACKEND_BASE_URL=http://backend:8000
UVICORN_LOG_LEVEL=info

# Existing PostgreSQL bootstrap account; use deployment credentials in production.
POSTGRES_DB=upraise_audit
POSTGRES_USER=upraise_dev
POSTGRES_PASSWORD=upraise_dev_password
JOBS_PASSWORD=upraise_jobs_password
AUDIT_PASSWORD=upraise_audit_password
# For special-character passwords, also set URI-encoded runtime connection strings.
# UPRAISE_JOBS_DSN=postgresql://upraise_jobs:ENCODED_PASSWORD@postgres:5432/upraise_jobs
# UPRAISE_AUDIT_DSN=postgresql://upraise_audit_app:ENCODED_PASSWORD@postgres:5432/upraise_audit

UPRAISE_AWS_REGION=eu-central-1
# Separate source-comparison pass; AUTO_CHECKED is not human verification.
UPRAISE_FIDELITY_VISION_MODEL_ID=eu.amazon.nova-pro-v1:0

# Page limit for PDF uploads and rendered Word documents.
UPRAISE_MAX_PDF_PAGES=1000

# CSV uploads: UTF-8 (optional BOM), header row, comma/semicolon/tab separator.
UPRAISE_MAX_CSV_SIZE_MB=100
UPRAISE_MAX_CSV_ROWS=100000
UPRAISE_MAX_CSV_COLUMNS=256

# Production is the default. Local Streamlit testing requires BOTH explicit values:
# UPRAISE_ENVIRONMENT=development and UPRAISE_LOCAL_TEST_MODE=true.
UPRAISE_ENVIRONMENT=production
UPRAISE_LOCAL_TEST_MODE=false
# Local curl JWT testing on the backend port requires development,
# UPRAISE_LOCAL_TEST_MODE=false, and a locally generated test secret.
UPRAISE_LOCAL_JWT_TEST_MODE=false
UPRAISE_JWT_TEST_CLIENT_SECRET=

# Ingestion is denied until all OAuth/mTLS settings below are supplied.
UPRAISE_OAUTH_ISSUER=
UPRAISE_OAUTH_AUDIENCE=
UPRAISE_OAUTH_JWKS_URL=
UPRAISE_OAUTH_CLIENTS=[]
UPRAISE_TRUSTED_PROXY_CIDRS=[]
UPRAISE_MTLS_ALLOWED_FINGERPRINTS=[]
# List values use JSON, e.g. ["middleware-client"] and ["10.0.0.2/32"].
# TLS gateway must overwrite X-SSL-Client-Verify and X-SSL-Client-Fingerprint.
# Service access tokens require iss, aud, exp, an allowed client_id (or azp/sub),
# and upraise_courses. The admin kill switch requires admin:operations. iat is optional.

# B1 requires course access on the service token and a signed Middleware
# assertion in X-UPRAISE-Session-JWT. The session audience must differ from OAuth.
# Local development permits JWT-free DRAFT preview; see backend/docs/b1.md.
UPRAISE_SESSION_JWT_ISSUER=
UPRAISE_SESSION_JWT_AUDIENCE=upraise-learner-session
UPRAISE_SESSION_JWT_JWKS_URL=
UPRAISE_SESSION_TTL_SECONDS=1800
UPRAISE_SESSION_MAX_COUNT=10000
UPRAISE_SESSION_SWEEP_SECONDS=30

# A3 v2 generates every profile in this ordered JSON object. Restart API/workers
# after changes, and use a new Idempotency-Key. The plan level must be a key here.
UPRAISE_LESSON_PLAN_LEVEL=intermediate
UPRAISE_LESSON_ALIGNMENT_BATCH_UNITS=4
# Compose keeps completed JSON/WAV packages in ./course_archive, beyond the
# temporary 24-hour delivery window. For non-Compose runs, choose a separate path:
# UPRAISE_LESSON_ARCHIVE_DIR=/absolute/path/to/course_archive
# Optional override; defaults are beginner, intermediate and advanced.
# UPRAISE_LESSON_LEVEL_PROFILES={"foundation":"Explain prerequisites step by step.","expert":"Explain formally, preserving the same material."}
# B4 uses the existing EU Bedrock models, Titan embeddings and Polly voice.
# Audio STT additionally requires transcribe:StartStreamTranscription.
UPRAISE_INTERRUPT_MAX_CONCURRENT=4
UPRAISE_INTERRUPT_MAX_AUDIO_BYTES=6000000
UPRAISE_INTERRUPT_MAX_AUDIO_SECONDS=60
UPRAISE_INTERRUPT_SOURCE_CHARACTERS=24000
UPRAISE_INTERRUPT_PROVIDER_TIMEOUT_SECONDS=45

# C1/C2: cheap cached checks; provider results expire without new successful calls.
# These operator controls are shared by API/workers; restart them to apply changes.
# C3 runtime controls persist in PostgreSQL. Deployment disables remain a safety floor.
# Development-only admin testing requires both development/local test mode and this opt-in.
UPRAISE_OPERATIONS_LOCAL_ADMIN=false
UPRAISE_OPERATIONS_REFRESH_SECONDS=10
UPRAISE_OPERATIONS_PROBE_TIMEOUT_SECONDS=2
UPRAISE_OPERATIONS_PROVIDER_TTL_SECONDS=900
UPRAISE_OPERATIONS_WORKER_TTL_SECONDS=150
UPRAISE_OPERATIONS_KILL_SWITCH=false
UPRAISE_OPERATIONS_KILL_SWITCH_COURSES=[]
UPRAISE_OPERATIONS_DISABLED_FEATURES=[]
# Example: {"course-1":["stt","generation"]}
UPRAISE_OPERATIONS_COURSE_DISABLED_FEATURES={}

# HTTPS download mode: no redirects. Private Moodle addresses need explicit CIDRs.
UPRAISE_MOODLE_ALLOWED_CIDRS=[]

# Zero retains the old pipeline's artifacts until retention is agreed.
UPRAISE_ARTIFACT_RETENTION_DAYS=0

# Worker attempt wall-clock limit and workload-based phase budgets, in seconds.
# Defaults are starting values; tune with representative PDFs and prewarm models.
# Progress updates do not restart deadlines. Timeout retries use the attempt limit.
UPRAISE_JOB_TIMEOUT_SECONDS=43200
UPRAISE_PARSE_TIMEOUT_BASE_SECONDS=180
UPRAISE_PARSE_TIMEOUT_PER_PAGE_SECONDS=10
UPRAISE_PARSE_TIMEOUT_PER_OCR_PAGE_SECONDS=30
UPRAISE_ENRICH_TIMEOUT_BASE_SECONDS=180
UPRAISE_ENRICH_TIMEOUT_PER_REGION_SECONDS=180
UPRAISE_EMBED_TIMEOUT_BASE_SECONDS=120
UPRAISE_EMBED_TIMEOUT_PER_CHUNK_SECONDS=90
# Supervisor limits and cancellation polling; status reads never block the watchdog.
UPRAISE_WORKER_STARTUP_TIMEOUT_SECONDS=300
UPRAISE_WORKER_PHASE_TIMEOUT_SECONDS=300
UPRAISE_WORKER_SUPERVISOR_POLL_SECONDS=1
# PostgreSQL statement timeout, not a guaranteed socket-operation deadline.
UPRAISE_WORKER_STATUS_TIMEOUT_SECONDS=2
UPRAISE_WORKER_TERMINATE_GRACE_SECONDS=5

# A3: Version 3 lesson workflow, source windows default to 5 pages.
# Target chunk length and source_window_pages are request options, not A1 settings.
UPRAISE_LESSON_GENERATION_MODEL_ID=openai.gpt-oss-120b-1:0
UPRAISE_LESSON_REVIEW_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
# Legacy configuration key; native V3 A3 does not call a separate PDF judge.
UPRAISE_LESSON_VISUAL_MODEL_ID=eu.amazon.nova-pro-v1:0
UPRAISE_POLLY_ENGINE=neural
UPRAISE_LESSON_TTL_SECONDS=86400
UPRAISE_LESSON_SOURCE_WAIT_SECONDS=86400
UPRAISE_LESSON_TIMEOUT_SECONDS=43200
UPRAISE_LESSON_SECONDS_PER_SECTION=1200
UPRAISE_LESSON_SECONDS_PER_CHUNK=180
UPRAISE_LESSON_MAX_SOURCE_CHARACTERS=120000
# Optional raw failed model replies, retained with lesson artifacts only in local testing.
UPRAISE_LESSON_CAPTURE_MODEL_OUTPUTS=false

# Optional A3 push delivery. Leave callback_url out of requests for A5 pull only.
# Outbound OAuth client credentials + mTLS is the approved design addition.
# Use deployment secrets; the AI needs its own client identity and key.
UPRAISE_LESSON_PUBLIC_BASE_URL=
UPRAISE_CALLBACK_ALLOWED_HOSTS=[]
UPRAISE_CALLBACK_ALLOWED_CIDRS=[]
UPRAISE_CALLBACK_TOKEN_URL=
UPRAISE_CALLBACK_CLIENT_ID=
UPRAISE_CALLBACK_CLIENT_SECRET=
UPRAISE_CALLBACK_OAUTH_AUTH_METHOD=client_secret_basic
# Also supports client_secret_post or tls_client_auth (no client secret).
UPRAISE_CALLBACK_SCOPE=lessons:deliver
UPRAISE_CALLBACK_CERTIFICATE=
UPRAISE_CALLBACK_PRIVATE_KEY=
UPRAISE_CALLBACK_CA_FILE=
UPRAISE_CALLBACK_MAX_ATTEMPTS=8
# Example file paths: /run/secrets/callback_tls/{client.pem,client.key,ca.pem}
# Configured OAuth server must issue expires_in <= 900 seconds and > 30 seconds.
UPRAISE_MAX_WORD_SIZE_MB=100
UPRAISE_MAX_WORD_UNCOMPRESSED_MB=1000
UPRAISE_WORD_CONVERSION_TIMEOUT_SECONDS=180
UPRAISE_WORD_VISUAL_FALLBACK=true
UPRAISE_MAX_POWERPOINT_SIZE_MB=100
UPRAISE_MAX_POWERPOINT_UNCOMPRESSED_MB=1000
UPRAISE_MAX_POWERPOINT_SLIDES=1000
UPRAISE_POWERPOINT_CONVERSION_TIMEOUT_SECONDS=180

# Optional client-facing UPRAISE interface (frontend2, localhost only).
FRONTEND2_PORT=8502
FRONTEND2_ACTIVITY_ID=upraise-learning
# Server-side gateway credentials; never sent to the browser. For Docker, mount
# PEM files read-only through an override and use their in-container paths.
FRONTEND2_BACKEND_TOKEN=
FRONTEND2_CLIENT_CERT=
FRONTEND2_CLIENT_KEY=
FRONTEND2_KEY_PASSWORD=
FRONTEND2_CA_CERT=
