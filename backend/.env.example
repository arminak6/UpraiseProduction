# Host execution: use real reachable PostgreSQL/Qdrant URLs.
# Compose supplies these through the root environment example.
UPRAISE_ENVIRONMENT=production
UPRAISE_LOCAL_TEST_MODE=false
UPRAISE_JOBS_DSN=
UPRAISE_AUDIT_DSN=
UPRAISE_QDRANT_URL=http://localhost:6333
UPRAISE_DATA_DIR=./data/ingestion
UPRAISE_AWS_CREDENTIALS_FILE=../aws_credentials.json
UPRAISE_AWS_REGION=eu-central-1
UPRAISE_OAUTH_ISSUER=
UPRAISE_OAUTH_AUDIENCE=
UPRAISE_OAUTH_JWKS_URL=
UPRAISE_OAUTH_CLIENTS=[]
UPRAISE_TRUSTED_PROXY_CIDRS=[]
UPRAISE_MTLS_ALLOWED_FINGERPRINTS=[]
